# ============================================================
# Gram Panchayat WhatsApp Bot — Environment Template
# Copy this file to .env and fill in your values
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public URL of your backend (set by Render automatically in production).
# For local dev, use your ngrok URL:
PUBLIC_URL=https://your-ngrok-url.ngrok-free.dev

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Twilio (WhatsApp Messaging) ───────────────────────────
USE_TWILIO=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox number for testing; use your approved number in production:
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Google Drive (Document Storage) ──────────────────────
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY\n-----END RSA PRIVATE KEY-----"
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_ROOT_FOLDER_ID

# ── Security ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string
ENCRYPTION_KEY=change-this-to-a-32-char-string!!
SESSION_SECRET=change-this-session-secret-value

# ── Bot Behaviour ──────────────────────────────────────────
SESSION_TIMEOUT_MS=900000
MAX_RETRY_ATTEMPTS=3
RATE_LIMIT_WINDOW_MS=1800000
BLOCK_DURATION_MS=1800000

# ── UPI Payment Settings ───────────────────────────────────
PAYEE_UPI_ID=yourname@upihandle
PAYEE_NAME=Gram Panchayat

# ── Dashboard URL (used for CORS in production) ────────────
DASHBOARD_URL=https://your-dashboard.onrender.com

# ── Interakt (not used when USE_TWILIO=true) ──────────────
# INTERAKT_API_KEY=your_interakt_api_key_here
